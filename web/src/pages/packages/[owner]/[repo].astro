---
import Layout from '~/layouts/Layout.astro';
import TagChip from '~/components/TagChip.astro';
import { packageLanguageEntries } from '~/lib/languages';
import { fetchApprovedPackages, ownerRepo } from '~/lib/packages';
import type { PackageRecord } from '~/lib/pb';

export async function getStaticPaths() {
  const all = await fetchApprovedPackages();
  return all.map((p) => {
    const { owner, repo } = ownerRepo(p.name);
    return {
      params: { owner, repo },
      props: { pkg: p },
    };
  });
}

interface Props {
  pkg: PackageRecord;
}

const { pkg } = Astro.props;
const submitterName = pkg.expand?.submitter?.name || pkg.expand?.submitter?.id || 'unknown';
const pushed = pkg.pushed_at
  ? new Date(pkg.pushed_at).toLocaleDateString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;
const implementations = packageLanguageEntries(pkg);
const implementationPromptLines = implementations.length > 0
  ? implementations.map((implementation) => `  - ${implementation.label}: ${implementation.branch}`).join('\n')
  : '  - no implementations configured yet; ask the package submitter for the branch';

const usePrompt = `- installer can be npx or uvx, ask me which one to use
- choose one implementation:
${implementationPromptLines}
- run <installer> bc-pkg ${pkg.name}@<chosen-branch> package validate
- iterate on failure`;
---

<Layout title={`${pkg.name} — BigConfig Marketplace`} description={pkg.description}>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-12">
    <a
      href="/packages"
      class="text-sm text-slate-600 hover:text-amber-700">← All packages</a
    >
    <div class="mt-6 flex flex-wrap items-start justify-between gap-6">
      <div>
        <h1
          class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl"
        >
          {pkg.name}
        </h1>
        <p class="mt-2 text-sm text-slate-500">added by {submitterName}</p>
        {
          pkg.tags && pkg.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {pkg.tags.map((t) => (
                <TagChip tag={t} />
              ))}
            </div>
          )
        }
      </div>
      <a
        href={pkg.github_url}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-yellow-300"
        >View on GitHub →</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <div
          class="rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8"
        >
          <h2 class="text-lg font-semibold text-slate-950">About</h2>
          <p class="mt-3 leading-relaxed text-slate-600">
            {pkg.description || 'No description provided.'}
          </p>
        </div>
        <div
          class="mt-6 rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8"
        >
          <h2 class="text-lg font-semibold text-slate-950">Implementations</h2>
          {
            implementations.length > 0 ? (
              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {implementations.map((implementation) => (
                  <div class="rounded-xl border border-yellow-200 bg-yellow-50/70 p-4">
                    <div class="text-sm font-semibold text-slate-950">
                      {implementation.label}
                    </div>
                    <div class="mt-1 font-mono text-xs text-amber-700">
                      {implementation.branch}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="mt-3 text-sm text-slate-600">
                No implementation branches have been configured yet.
              </p>
            )
          }
        </div>
        <div
          class="mt-6 rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8"
        >
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-lg font-semibold text-slate-950">Use it</h2>
            <button
              id="copy-use-prompt"
              type="button"
              data-prompt={usePrompt}
              class="rounded-full border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:border-yellow-400 hover:text-amber-700"
            >
              Copy prompt
            </button>
          </div>
          <p class="mt-3 text-sm text-slate-600">
            Give this prompt to your agent to create the local files, ask for
            missing values, and operate the package lifecycle.
          </p>
          <pre
            class="bc-code-card mt-4 whitespace-pre-wrap rounded-lg p-3 text-xs leading-relaxed"><code>{usePrompt}</code></pre>
          <p class="mt-4 text-sm text-slate-600">
            The prompt follows the documented <a
              href="/documentation#bigconfig-package"
              class="text-amber-600 hover:underline">BigConfig Package</a
            > flow.
          </p>
        </div>
        {
          pkg.og_image && (
            <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200">
              <img
                src={pkg.og_image}
                alt={`${pkg.name} preview`}
                class="w-full"
                loading="lazy"
              />
            </div>
          )
        }
      </div>
      <aside class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-6">
          <div class="text-xs font-semibold tracking-widest text-slate-500 uppercase">
            Repository
          </div>
          <dl class="mt-3 space-y-3 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-slate-600">Stars</dt>
              <dd class="text-slate-950">{pkg.stars}</dd>
            </div>
            {
              pkg.default_branch && (
                <div class="flex justify-between gap-4">
                  <dt class="text-slate-600">Default branch</dt>
                  <dd class="text-slate-950 font-mono text-xs">
                    {pkg.default_branch}
                  </dd>
                </div>
              )
            }
            {
              pushed && (
                <div class="flex justify-between gap-4">
                  <dt class="text-slate-600">Last push</dt>
                  <dd class="text-slate-950">{pushed}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('copy-use-prompt') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    const prompt = btn.dataset.prompt ?? '';
    try {
      await navigator.clipboard.writeText(prompt);
      const prev = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => (btn.textContent = prev), 1200);
    } catch {}
  });
</script>
