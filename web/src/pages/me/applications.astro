---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="My applications — BigConfig Marketplace">
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div
          class="mb-4 inline-block text-xs font-semibold tracking-widest text-amber-600 uppercase"
        >
          My applications
        </div>
        <h1
          class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl"
        >
          Your submissions.
        </h1>
        <p id="user-line" class="mt-2 text-sm text-slate-500"></p>
      </div>
      <div class="flex gap-3">
        <a
          href="/applications/submit"
          class="rounded-full bg-yellow-400 px-5 py-2.5 text-sm font-semibold text-slate-950 hover:bg-yellow-300"
          >Add</a
        >
        <a
          href="/me/packages"
          class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-yellow-500/60 hover:text-slate-950"
          >My packages</a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div
      id="auth-gate"
      class="hidden rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-10 text-center"
    >
      <p class="text-slate-600">Sign in to see your submissions.</p>
      <a
        href="/login/?next=/me/applications/"
        class="mt-6 inline-block rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-yellow-300"
        >Sign in with Google</a
      >
    </div>
    <div id="loading" class="text-center text-slate-500">Loading…</div>
    <div id="empty" class="hidden text-center text-slate-600">
      <p>You haven't added any applications yet.</p>
      <a
        href="/applications/submit"
        class="mt-6 inline-block rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-yellow-300"
        >Add one</a
      >
    </div>
    <div id="grid" class="hidden grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
  </section>
</Layout>

<script>
  import PocketBase from 'pocketbase';
  import { escapeHtml } from '../../lib/pb';

  const pb = new PocketBase(import.meta.env.PUBLIC_PB_URL || '');
  const gate = document.getElementById('auth-gate')!;
  const loading = document.getElementById('loading')!;
  const empty = document.getElementById('empty')!;
  const grid = document.getElementById('grid')!;
  const userLine = document.getElementById('user-line')!;

  function statusPill(status: string): string {
    const base =
      'inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-widest uppercase';
    if (status === 'approved')
      return `<span class="${base} bg-green-50 text-green-700 ring-1 ring-green-200">approved</span>`;
    if (status === 'rejected')
      return `<span class="${base} bg-red-50 text-red-700 ring-1 ring-red-200">rejected</span>`;
    return `<span class="${base} bg-yellow-50 text-amber-700 ring-1 ring-yellow-200">pending review</span>`;
  }

  async function load() {
    if (!pb.authStore.isValid) {
      loading.classList.add('hidden');
      gate.classList.remove('hidden');
      return;
    }
    const me = pb.authStore.record;
    userLine.textContent = `Signed in as ${me?.name || me?.email || me?.id}.`;
    try {
      const records = await pb.collection('applications').getFullList({
        filter: pb.filter('submitter = {:id}', { id: me?.id }),
        sort: '-created',
      });
      loading.classList.add('hidden');
      if (records.length === 0) {
        empty.classList.remove('hidden');
        return;
      }
      grid.classList.remove('hidden');
      grid.innerHTML = records
        .map((a: any) => {
          const tags = (a.tags || [])
            .map(
              (t: string) =>
                `<span class="rounded-full border border-slate-200 bg-white/80 px-2.5 py-0.5 text-xs text-slate-600">${escapeHtml(t)}</span>`
            )
            .join('');
          return `
          <div class="flex flex-col rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold text-slate-950">${escapeHtml(a.name)}</h3>
              ${statusPill(a.status)}
            </div>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">${escapeHtml(a.description || '')}</p>
            <div class="mt-3 font-mono text-xs text-slate-500 truncate">${escapeHtml(a.docker_image || '')}</div>
            <div class="mt-5 flex flex-wrap gap-2">${tags}</div>
            <div class="mt-6 flex gap-3">
              <a href="/me/applications-edit/?id=${encodeURIComponent(a.id)}" class="rounded-full border border-slate-300 px-4 py-1.5 text-xs font-semibold text-slate-700 hover:border-yellow-400 hover:text-amber-700">Edit</a>
              <a href="${escapeHtml(a.github_url)}" target="_blank" rel="noopener" class="rounded-full border border-slate-300 px-4 py-1.5 text-xs font-semibold text-slate-700 hover:border-yellow-400 hover:text-amber-700">GitHub</a>
            </div>
          </div>`;
        })
        .join('');
    } catch (err) {
      console.error(err);
      loading.textContent = 'Could not load your applications.';
    }
  }

  load();
</script>
