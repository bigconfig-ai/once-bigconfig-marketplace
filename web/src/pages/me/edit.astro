---
import Layout from '~/layouts/Layout.astro';
import { LANGUAGE_OPTIONS } from '~/lib/languages';
import { TAG_GROUPS } from '~/lib/tags';
---

<Layout title="Edit package — BigConfig Marketplace">
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-24">
    <a href="/me/packages" class="text-sm text-slate-600 hover:text-amber-700"
      >← Back to my packages</a
    >
    <div class="mt-6">
      <div
        class="mb-4 inline-block text-xs font-semibold tracking-widest text-amber-600 uppercase"
      >
        Edit
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
        <span id="pkg-name">Package</span>
      </h1>
    </div>

    <div
      id="auth-gate"
      class="mt-12 hidden rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-10 text-center"
    >
      <p class="text-slate-600">Sign in to edit your packages.</p>
      <a
        id="login-link"
        href="/login/"
        class="mt-6 inline-block rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-yellow-300"
        >Sign in</a
      >
    </div>

    <div id="loading" class="mt-12 text-center text-slate-500">Loading…</div>
    <div
      id="error"
      class="mt-12 hidden rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-10 text-center text-slate-600"
    >
    </div>

    <form
      id="edit-form"
      class="mt-12 hidden grid gap-5 rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8 md:p-10"
    >
      <label class="block text-sm">
        <span class="mb-2 block font-medium text-slate-700">GitHub URL</span>
        <input
          name="github_url"
          type="url"
          disabled
          class="w-full rounded-lg border border-slate-200 bg-slate-100 px-4 py-3 text-slate-600 outline-none"
        />
        <span class="mt-1 block text-xs text-slate-500"
          >URL is locked once added. Delete and add it again if you need a
          different repo.</span
        >
      </label>
      <div>
        <span class="mb-2 block text-sm font-medium text-slate-700">Languages</span>
        <p class="mb-3 text-xs text-slate-500">
          Select every implementation this repo provides and enter the explicit branch name for each one.
        </p>
        <div class="grid gap-3">
          {LANGUAGE_OPTIONS.map((language) => (
            <div class="rounded-xl border border-slate-200 bg-white/70 p-4">
              <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700">
                <input
                  type="checkbox"
                  name="languages"
                  value={language.slug}
                  class="language-checkbox h-4 w-4 rounded border-slate-300 text-yellow-400 focus:ring-yellow-400"
                />
                {language.label}
              </label>
              <input
                name={`branch_${language.slug}`}
                type="text"
                data-language={language.slug}
                disabled
                placeholder="branch name"
                class="language-branch-input mt-3 w-full rounded-lg border border-slate-300 bg-white px-4 py-2 font-mono text-sm text-slate-950 placeholder-slate-400 outline-none focus:border-yellow-400 disabled:bg-slate-100 disabled:text-slate-400"
              />
            </div>
          ))}
        </div>
      </div>
      <label class="block text-sm">
        <span class="mb-2 block font-medium text-slate-700">Description</span>
        <textarea
          name="description"
          rows="3"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 placeholder-slate-400 outline-none focus:border-yellow-400"
        ></textarea>
      </label>
      <div>
        <span class="mb-2 block text-sm font-medium text-slate-700">Tags</span
        >
        <div class="space-y-3">
          {
            TAG_GROUPS.map((group) => (
              <div>
                <div class="mb-1.5 text-xs font-semibold tracking-wider text-slate-500 uppercase">
                  {group.label}
                </div>
                <div class="flex flex-wrap gap-2">
                  {group.tags.map((t) => (
                    <label class="cursor-pointer">
                      <input
                        type="checkbox"
                        name="tags"
                        value={t}
                        class="peer sr-only"
                      />
                      <span class="rounded-full border border-slate-200 bg-white/80 px-2.5 py-0.5 text-xs text-slate-600 transition peer-checked:bg-yellow-400 peer-checked:text-slate-950">
                        {t}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-yellow-300 disabled:opacity-60"
          >Save changes</button
        >
        <button
          type="button"
          id="delete-btn"
          class="rounded-full border border-red-300 px-6 py-3 text-sm font-semibold text-red-600 transition hover:border-red-400 hover:bg-red-50"
          >Delete package</button
        >
      </div>
      <p
        id="form-status"
        class="hidden text-center text-sm text-slate-600"
      >
      </p>
    </form>
  </section>
</Layout>

<script>
  import PocketBase from 'pocketbase';
  import { LANGUAGE_OPTIONS } from '../../lib/languages';
  import { formatPbError } from '../../lib/pb';

  const pb = new PocketBase(import.meta.env.PUBLIC_PB_URL || '');
  const gate = document.getElementById('auth-gate')!;
  const loading = document.getElementById('loading')!;
  const errorBox = document.getElementById('error')!;
  const form = document.getElementById('edit-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const nameEl = document.getElementById('pkg-name')!;
  const deleteBtn = document.getElementById('delete-btn')!;
  const loginLink = document.getElementById('login-link') as HTMLAnchorElement | null;
  const languageCheckboxes = Array.from(
    form.querySelectorAll<HTMLInputElement>('.language-checkbox')
  );

  function branchInput(language: string): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>(
      `.language-branch-input[data-language="${CSS.escape(language)}"]`
    );
  }

  function syncLanguageInputs() {
    for (const checkbox of languageCheckboxes) {
      const input = branchInput(checkbox.value);
      if (!input) continue;
      input.disabled = !checkbox.checked;
      input.required = checkbox.checked;
    }
  }

  function collectLanguageBranches(): Record<string, string> | null {
    const branches: Record<string, string> = {};
    for (const language of LANGUAGE_OPTIONS) {
      const checkbox = form.querySelector<HTMLInputElement>(
        `input[name="languages"][value="${CSS.escape(language.slug)}"]`
      );
      if (!checkbox?.checked) continue;
      const branch = branchInput(language.slug)?.value.trim() ?? '';
      if (!branch) {
        status.classList.remove('hidden');
        status.textContent = `Enter a branch for ${language.label}.`;
        return null;
      }
      branches[language.slug] = branch;
    }
    if (Object.keys(branches).length === 0) {
      status.classList.remove('hidden');
      status.textContent = 'Select at least one language implementation.';
      return null;
    }
    return branches;
  }

  for (const checkbox of languageCheckboxes) {
    checkbox.addEventListener('change', syncLanguageInputs);
  }
  syncLanguageInputs();

  const id = new URLSearchParams(location.search).get('id') || '';

  if (!id) {
    loading.classList.add('hidden');
    errorBox.classList.remove('hidden');
    errorBox.textContent = 'No package id in URL.';
  } else if (!pb.authStore.isValid) {
    loading.classList.add('hidden');
    if (loginLink) {
      loginLink.href = `/login/?next=${encodeURIComponent(`/me/edit/?id=${id}`)}`;
    }
    gate.classList.remove('hidden');
  } else {
    load();
  }

  async function load() {
    try {
      const pkg: any = await pb.collection('packages').getOne(id);
      const me = pb.authStore.record;
      if (pkg.submitter !== me?.id) {
        loading.classList.add('hidden');
        errorBox.classList.remove('hidden');
        errorBox.textContent = 'You can only edit packages you added.';
        return;
      }
      nameEl.textContent = pkg.name;
      (form.elements.namedItem('github_url') as HTMLInputElement).value =
        pkg.github_url;
      (form.elements.namedItem('description') as HTMLTextAreaElement).value =
        pkg.description || '';
      const branches: Record<string, string> = pkg.language_branches || {};
      for (const language of LANGUAGE_OPTIONS) {
        const checkbox = form.querySelector<HTMLInputElement>(
          `input[name="languages"][value="${CSS.escape(language.slug)}"]`
        );
        const input = branchInput(language.slug);
        const branch = branches[language.slug] || '';
        if (checkbox) checkbox.checked = Boolean(branch);
        if (input) input.value = branch;
      }
      syncLanguageInputs();
      const tags: string[] = pkg.tags || [];
      for (const t of tags) {
        const cb = form.querySelector<HTMLInputElement>(
          `input[name="tags"][value="${CSS.escape(t)}"]`
        );
        if (cb) cb.checked = true;
      }
      loading.classList.add('hidden');
      form.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
      errorBox.textContent = 'Could not load this package.';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const language_branches = collectLanguageBranches();
    if (!language_branches) return;
    const data = new FormData(form);
    const payload = {
      language_branches,
      description: data.get('description'),
      tags: data.getAll('tags') as string[],
    };
    status.classList.remove('hidden');
    status.textContent = 'Saving (verifying branches)…';
    try {
      await pb.collection('packages').update(id, payload);
      status.textContent = 'Saved.';
      setTimeout(() => (location.href = '/me/packages'), 800);
    } catch (err: any) {
      console.error(err);
      status.textContent = formatPbError(err, 'Save failed.');
    }
  });

  deleteBtn?.addEventListener('click', async () => {
    if (!confirm('Delete this package? This cannot be undone.')) return;
    try {
      await pb.collection('packages').delete(id);
      location.href = '/me/packages';
    } catch (err: any) {
      console.error(err);
      status.classList.remove('hidden');
      status.textContent = formatPbError(err, 'Delete failed.');
    }
  });
</script>
