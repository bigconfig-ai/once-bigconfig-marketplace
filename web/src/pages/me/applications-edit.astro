---
import Layout from '~/layouts/Layout.astro';
import { APPLICATION_TAG_GROUPS as TAG_GROUPS } from '~/lib/tags';
---

<Layout title="Edit application — BigConfig Marketplace">
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-24">
    <a href="/me/applications" class="text-sm text-slate-600 hover:text-amber-700"
      >← Back to my applications</a
    >
    <div class="mt-6">
      <div
        class="mb-4 inline-block text-xs font-semibold tracking-widest text-amber-600 uppercase"
      >
        Edit
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-slate-950 md:text-5xl">
        <span id="app-name">Application</span>
      </h1>
    </div>

    <div
      id="auth-gate"
      class="mt-12 hidden rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-10 text-center"
    >
      <p class="text-slate-600">Sign in to edit your applications.</p>
      <a
        href="/login"
        class="mt-6 inline-block rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-yellow-300"
        >Sign in</a
      >
    </div>

    <div id="loading" class="mt-12 text-center text-slate-500">Loading…</div>
    <div
      id="error"
      class="mt-12 hidden rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-10 text-center text-slate-600"
    >
    </div>

    <form
      id="edit-form"
      class="mt-12 hidden grid gap-5 rounded-2xl border border-slate-200 bg-white/85 shadow-sm shadow-slate-900/5 p-8 md:p-10"
    >
      <label class="block text-sm">
        <span class="mb-2 block font-medium text-slate-700">GitHub URL</span>
        <input
          name="github_url"
          type="url"
          disabled
          class="w-full rounded-lg border border-slate-200 bg-slate-100 px-4 py-3 text-slate-600 outline-none"
        />
        <span class="mt-1 block text-xs text-slate-500"
          >URL is locked once added. Delete and add it again if you need a
          different repo.</span
        >
      </label>
      <label class="block text-sm">
        <span class="mb-2 block font-medium text-slate-700">Docker image</span>
        <input
          name="docker_image"
          type="text"
          disabled
          class="w-full rounded-lg border border-slate-200 bg-slate-100 px-4 py-3 font-mono text-slate-600 outline-none"
        />
        <span class="mt-1 block text-xs text-slate-500"
          >Image is locked once added. Delete and add it again to change it.</span
        >
      </label>
      <label class="block text-sm">
        <span class="mb-2 block font-medium text-slate-700">Description</span>
        <textarea
          name="description"
          rows="3"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-950 placeholder-slate-400 outline-none focus:border-yellow-400"
        ></textarea>
      </label>
      <div>
        <span class="mb-2 block text-sm font-medium text-slate-700">Tags</span
        >
        <div class="space-y-3">
          {
            TAG_GROUPS.map((group) => (
              <div>
                <div class="mb-1.5 text-xs font-semibold tracking-wider text-slate-500 uppercase">
                  {group.label}
                </div>
                <div class="flex flex-wrap gap-2">
                  {group.tags.map((t) => (
                    <label class="cursor-pointer">
                      <input
                        type="checkbox"
                        name="tags"
                        value={t}
                        class="peer sr-only"
                      />
                      <span class="rounded-full border border-slate-200 bg-white/80 px-2.5 py-0.5 text-xs text-slate-600 transition peer-checked:bg-yellow-400 peer-checked:text-slate-950">
                        {t}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-full bg-yellow-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-yellow-300 disabled:opacity-60"
          >Save changes</button
        >
        <button
          type="button"
          id="delete-btn"
          class="rounded-full border border-red-300 px-6 py-3 text-sm font-semibold text-red-600 transition hover:border-red-400 hover:bg-red-50"
          >Delete application</button
        >
      </div>
      <p
        id="form-status"
        class="hidden text-center text-sm text-slate-600"
      >
      </p>
    </form>
  </section>
</Layout>

<script>
  import PocketBase from 'pocketbase';
  import { formatPbError } from '../../lib/pb';

  const pb = new PocketBase(import.meta.env.PUBLIC_PB_URL || '');
  const gate = document.getElementById('auth-gate')!;
  const loading = document.getElementById('loading')!;
  const errorBox = document.getElementById('error')!;
  const form = document.getElementById('edit-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const nameEl = document.getElementById('app-name')!;
  const deleteBtn = document.getElementById('delete-btn')!;

  const id = new URLSearchParams(location.search).get('id') || '';

  if (!id) {
    loading.classList.add('hidden');
    errorBox.classList.remove('hidden');
    errorBox.textContent = 'No application id in URL.';
  } else if (!pb.authStore.isValid) {
    loading.classList.add('hidden');
    gate.classList.remove('hidden');
  } else {
    load();
  }

  async function load() {
    try {
      const app: any = await pb.collection('applications').getOne(id);
      const me = pb.authStore.record;
      if (app.submitter !== me?.id) {
        loading.classList.add('hidden');
        errorBox.classList.remove('hidden');
        errorBox.textContent = 'You can only edit applications you added.';
        return;
      }
      nameEl.textContent = app.name;
      (form.elements.namedItem('github_url') as HTMLInputElement).value =
        app.github_url;
      (form.elements.namedItem('docker_image') as HTMLInputElement).value =
        app.docker_image || '';
      (form.elements.namedItem('description') as HTMLTextAreaElement).value =
        app.description || '';
      const tags: string[] = app.tags || [];
      for (const t of tags) {
        const cb = form.querySelector<HTMLInputElement>(
          `input[name="tags"][value="${CSS.escape(t)}"]`
        );
        if (cb) cb.checked = true;
      }
      loading.classList.add('hidden');
      form.classList.remove('hidden');
    } catch (err) {
      console.error(err);
      loading.classList.add('hidden');
      errorBox.classList.remove('hidden');
      errorBox.textContent = 'Could not load this application.';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const payload = {
      description: data.get('description'),
      tags: data.getAll('tags') as string[],
    };
    status.classList.remove('hidden');
    status.textContent = 'Saving…';
    try {
      await pb.collection('applications').update(id, payload);
      status.textContent = 'Saved.';
      setTimeout(() => (location.href = '/me/applications'), 800);
    } catch (err: any) {
      console.error(err);
      status.textContent = formatPbError(err, 'Save failed.');
    }
  });

  deleteBtn?.addEventListener('click', async () => {
    if (!confirm('Delete this application? This cannot be undone.')) return;
    try {
      await pb.collection('applications').delete(id);
      location.href = '/me/applications';
    } catch (err: any) {
      console.error(err);
      status.classList.remove('hidden');
      status.textContent = formatPbError(err, 'Delete failed.');
    }
  });
</script>
