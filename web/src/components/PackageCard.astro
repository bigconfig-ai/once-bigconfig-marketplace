---
import TagChip from './TagChip.astro';
import type { PackageRecord } from '~/lib/pb';
import { ownerRepo } from '~/lib/packages';

interface Props {
  pkg: PackageRecord;
  highlighted?: boolean;
  showType?: boolean;
}

const { pkg, highlighted = false, showType = false } = Astro.props;
const { owner, repo } = ownerRepo(pkg.name);
const submitterName = pkg.expand?.submitter?.name || pkg.expand?.submitter?.id || 'unknown';
---

<a
  href={`/packages/${owner}/${repo}`}
  class:list={[
    'relative flex flex-col overflow-hidden rounded-2xl border p-8 shadow-sm shadow-slate-900/5 transition',
    highlighted
      ? 'border-yellow-300 bg-yellow-50/70 hover:border-yellow-400 hover:bg-yellow-50'
      : showType
        ? 'border-yellow-200 bg-white/85 hover:border-yellow-400/70 hover:bg-white hover:shadow-lg hover:shadow-slate-900/10'
        : 'border-slate-200 bg-white/85 hover:border-yellow-400/70 hover:bg-white hover:shadow-lg hover:shadow-slate-900/10',
  ]}
>
  {
    showType && (
      <>
        <div
          aria-hidden="true"
          class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-yellow-300 to-orange-500"
        />
        <div class="mb-4">
          <span class="inline-flex items-center gap-2 rounded-full border border-yellow-300/70 bg-yellow-100/80 px-2.5 py-1 text-[11px] font-semibold tracking-wider text-amber-700 uppercase">
            <span class="h-1.5 w-1.5 rounded-full bg-yellow-400" />
            Package
          </span>
        </div>
      </>
    )
  }
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-xl text-slate-950">
        <span class="font-normal">{owner}</span>
        <span class="text-slate-400"> / </span>
        <span class="font-semibold">{repo}</span>
      </h3>
      <div class="mt-1 text-xs text-slate-500">
        added by {submitterName}
      </div>
    </div>
    {
      pkg.stars > 0 && (
        <div class="flex items-center gap-1 text-xs text-slate-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01z" />
          </svg>
          {pkg.stars}
        </div>
      )
    }
  </div>
  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
    {pkg.description}
  </p>
  {
    pkg.tags && pkg.tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {pkg.tags.map((t) => <TagChip tag={t} />)}
      </div>
    )
  }
</a>
