---
interface Props {
  tag: string;
  active?: boolean;
}
const { tag, active = false } = Astro.props;
---

<span
  class:list={[
    'rounded-full px-2.5 py-0.5 text-xs',
    active
      ? 'bg-yellow-400 text-slate-950'
      : 'border border-slate-200 bg-white/85 text-slate-600',
  ]}
  data-tag={tag}>{tag}</span
>
